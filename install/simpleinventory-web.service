[Unit]
Description=SimpleInventory WebUI
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=simpleinventory-webui
Group=simpleinventory-webui
WorkingDirectory=/opt/simpleinventory-webui/current
Environment=SIW_AUTH_ENABLED=false
EnvironmentFile=-/etc/simpleinventory-webui/app.env
EnvironmentFile=-/etc/simpleinventory-webui/web.env
ExecStart=/opt/simpleinventory-webui/venv/bin/python -m uvicorn webui.web:app --host 0.0.0.0 --port 80 --no-proxy-headers --no-access-log
Restart=on-failure
RestartSec=5
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
UMask=0077

[Install]
WantedBy=multi-user.target
